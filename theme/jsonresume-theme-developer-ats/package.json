{
  "name": "jsonresume-theme-developer-ats",
  "version": "0.3.0",
  "description": "Technical, ATS-safe theme with monospace headers and sans-serif body, built from separated components and styled with Tailwind CSS. Single-column, print-optimized layout.",
  "type": "module",
  "main": "./dist/index.js",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@jsonresume/utils": "^0.2.2"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/generated/tailwind.css --minify",
    "build": "npm run build:css && vite build",
    "watch": "npm run build:css && vite build -w"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  }
}
